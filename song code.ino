if(n%KEY)for(uint16_t i=0;i<1024;i++)cur[i]^=prev[i];memcpy(d.getBuffer(),cur,1024);d.display();memcpy(prev,cur,1024);}
void resetStream(){ep=rp=0;qi=4;qc=0;memset(prev,0,1024);}
void setup(){Wire.begin(SDA_PIN,SCL_PIN);Wire.setClock(400000);if(!d.begin(SSD1306_SWITCHCAPVCC,OLED_ADDR))while(1);d.clearDisplay();d.display();resetStream();}
void loop(){uint32_t next=micros();for(uint16_t n=0;n<FRAMES;n++){decodeFrame(n);next+=33333;while((int32_t)(micros()-next)<0)yield();}resetStream();}
